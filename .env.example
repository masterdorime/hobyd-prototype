# .env.example — copy to .env.local and fill secrets (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
SELLER_ALLOWLIST=
MAX_SNIPING_EXTENSIONS=5
PAYMENT_WINDOW_SEC=300
# soft-close trigger window (seconds before end when a bid extends)
EXTENSION_WINDOW_SEC=10
# seconds added per soft-close extension
EXTENSION_ADD_SEC=10
